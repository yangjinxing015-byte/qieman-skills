{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qieman Design Content Audit Result",
  "type": "object",
  "required": [
    "source_of_truth",
    "audit_targets",
    "summary",
    "issues"
  ],
  "properties": {
    "source_of_truth": {
      "type": "string"
    },
    "audit_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "page_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "p0",
        "p1",
        "p2"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "p0": {
          "type": "integer"
        },
        "p1": {
          "type": "integer"
        },
        "p2": {
          "type": "integer"
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "dimension",
          "location",
          "source_text",
          "target_text",
          "description",
          "suggested_fix"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "dimension": {
            "enum": [
              "文案完整性",
              "文字内容",
              "数据与数字",
              "单位与符号",
              "时间周期表述",
              "合规文案",
              "标点符号",
              "大小写与全半角",
              "排版顺序",
              "语气偏差",
              "需求文档本身问题",
              "装饰性文字"
            ]
          },
          "sub_dimension": {
            "type": "string"
          },
          "issue_type": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "source_reference": {
            "type": "string"
          },
          "target_reference": {
            "type": "string"
          },
          "source_text": {
            "type": "string"
          },
          "target_text": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          },
          "is_deterministic_error": {
            "type": "boolean"
          },
          "confidence": {
            "enum": [
              "高",
              "中",
              "低"
            ]
          },
          "match": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "text",
                  "selector",
                  "coordinates"
                ]
              },
              "value": {
                "type": "string"
              },
              "matchAll": {
                "type": "boolean"
              },
              "caseSensitive": {
                "type": "boolean"
              }
            }
          },
          "occurrences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pageId"
              ],
              "properties": {
                "pageId": {
                  "type": "string"
                },
                "occurrenceId": {
                  "type": "string"
                },
                "locationLabel": {
                  "type": "string"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "verified_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unverifiable_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_report": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "issue_count": {
          "type": "integer"
        },
        "occurrence_count": {
          "type": "integer"
        },
        "output_file": {
          "type": "string"
        }
      }
    }
  }
}
